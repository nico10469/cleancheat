# Optional: bake API keys into a build instead of typing them in Settings.
# Copy to .env.local (git-ignored). Keys entered in the app's Settings screen take priority.
# Note: EXPO_PUBLIC_* values are embedded in the app bundle, so only use this for personal builds.
EXPO_PUBLIC_ANTHROPIC_API_KEY=
EXPO_PUBLIC_GOOGLE_API_KEY=
EXPO_PUBLIC_GOOGLE_CX=
